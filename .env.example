# =============================================================================
# AutoRAG 汽车售后 RAG 知识库问答系统 —— 环境变量模板
# 用法：复制本文件为 .env，然后把所有 [待补充] 的地方填成你自己的值。
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / macOS:       cp .env.example .env
# 说明：本模板中凡是需要你手动填写的位置，一律用 [待补充] 标注。
# =============================================================================

# -----------------------------------------------------------------------------
# [必填] LLM 对话模型 —— OpenAI 兼容接口
# 只要服务商提供 /v1/chat/completions 就可用：DeepSeek / 阿里云百炼(兼容模式) /
# 硅基流动 / 智谱 / Moonshot / vLLM / Ollama / OpenAI 官方 等。
# -----------------------------------------------------------------------------
LLM_API_KEY=[待补充]
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# -----------------------------------------------------------------------------
# Embedding 向量模型 —— 两种模式二选一
#   provider = api  : 调 OpenAI 兼容的 /v1/embeddings 接口（推荐，效果好）
#   provider = local: 本地 sentence-transformers 模型（需装 requirements-local.txt）
#   provider = hash : 零依赖本地哈希向量（只用于打通链路/自测，语义检索能力很弱）
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=hash

# provider=api 时必填：
EMBEDDING_API_KEY=[待补充]
EMBEDDING_BASE_URL=[待补充]
EMBEDDING_MODEL=[待补充]
EMBEDDING_DIM=[待补充]

# provider=local 时使用：
LOCAL_EMBEDDING_MODEL=[待补充]
LOCAL_EMBEDDING_DIM=[待补充]

# provider=hash 时使用（无需任何 Key）：
HASH_EMBEDDING_DIM=1024

# -----------------------------------------------------------------------------
# 知识库路径（容器内路径见 docker-compose.yml，本地跑就用默认值即可）
# -----------------------------------------------------------------------------
DOCUMENTS_DIR=./data/documents
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
REGISTRY_PATH=./data/registry.json
BM25_INDEX_PATH=./data/bm25_index.json
CHROMA_COLLECTION=auto_after_sales

# -----------------------------------------------------------------------------
# 文档切分参数
#   CHUNK_SIZE    目标块大小（字符数，中文场景按字符计）
#   CHUNK_OVERLAP 相邻块重叠（字符数）
#   CHUNK_MIN_CHARS 小于该长度的碎块会被合并到上一块
# -----------------------------------------------------------------------------
CHUNK_SIZE=600
CHUNK_OVERLAP=80
CHUNK_MIN_CHARS=80

# -----------------------------------------------------------------------------
# 检索参数
#   RETRIEVAL_MODE: vector（纯向量）/ keyword（纯 BM25）/ hybrid（RRF 融合，推荐）
#   RRF_K         : RRF 融合常数，常用 60
#   VECTOR_WEIGHT / KEYWORD_WEIGHT: 融合权重，仅 hybrid 生效
#   TOP_K         : 最终喂给大模型的片段数
#   CANDIDATE_K   : 每路召回候选数
#   MIN_SCORE     : 低于该分数视为"没检索到"，直接触发兜底回答
# -----------------------------------------------------------------------------
RETRIEVAL_MODE=hybrid
RRF_K=60
VECTOR_WEIGHT=1.0
KEYWORD_WEIGHT=0.8
TOP_K=5
CANDIDATE_K=20
MIN_SCORE=0.05

# 检索不到依据时是否直接返回兜底话术（不做无依据生成）
REFUSE_WHEN_EMPTY=true

# -----------------------------------------------------------------------------
# 服务参数
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=
LOG_LEVEL=INFO
CORS_ORIGINS=*
MAX_UPLOAD_MB=20

# -----------------------------------------------------------------------------
# Agent（LangGraph）：业务工具知识库 + 对话 checkpoint
#   AGENT_KB_PATH          故障码/保养周期结构化库（启动时若为空会从示例文档自动建立）
#   AGENT_CHECKPOINT_PATH  对话状态持久化（SqliteSaver），支持"追问后继续"与多轮上下文
#   AGENT_MAX_ITERATIONS   单轮最多调用工具的轮数，默认 6，超过则强制收尾
# -----------------------------------------------------------------------------
AGENT_KB_PATH=./data/agent_kb.db
AGENT_CHECKPOINT_PATH=./data/agent_checkpoints.db
AGENT_MAX_ITERATIONS=6
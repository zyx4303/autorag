# =============================================================================
# 参考配置样本：EMBEDDING_PROVIDER=api（正式使用推荐）
#
# 用法：把这几个值抄到你的 .env 里，替换成你实际使用的服务商参数。
# 注意：
#   1. 本文件里的地址与模型名都是**示例格式**，请以你所用服务商的官方文档为准；
#   2. EMBEDDING_DIM 必须与该模型真实输出维度一致，填错会在入库时报维度不一致；
#   3. 从 hash 切到 api 后，必须重建向量库：python scripts/ingest.py --rebuild
# =============================================================================

# ---------- 示例 1：DeepSeek 对话 + 阿里云百炼(兼容模式) 向量 ----------
# LLM_API_KEY=[待补充]
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
#
# EMBEDDING_PROVIDER=api
# EMBEDDING_API_KEY=[待补充]
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_DIM=1024

# ---------- 示例 2：对话与向量都走 OpenAI 兼容服务 ----------
# LLM_API_KEY=[待补充]
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
#
# EMBEDDING_PROVIDER=api
# EMBEDDING_API_KEY=[待补充]
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

# ---------- 示例 3：本地 Ollama（无需云端 Key） ----------
# LLM_API_KEY=ollama            # Ollama 不校验 Key，但不能为空，随便填一个非占位值
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b
#
# EMBEDDING_PROVIDER=local
# LOCAL_EMBEDDING_MODEL=[待补充]  # 例如你已下载到本地的 BAAI/bge-small-zh-v1.5

# =============================================================================
# 填完之后的自检步骤
#   1) 重启服务，打开 http://127.0.0.1:8000/api/v1/health
#      确认 embedding.provider=api、llm_ready=true、notes 里没有降级提示；
#   2) POST /api/v1/ingest {"rebuild": true, "reset_registry": true}
#   3) POST /api/v1/retrieve  {"query": "首保周期"} 看召回是否合理
#   4) POST /api/v1/chat      {"question": "首保周期是多久？"}
#      检查 citations 是否非空、answer 里的 [n] 是否都能对上；
#   5) python scripts/run_eval.py --limit 5 跑少量评测确认端到端可用。
# =============================================================================
